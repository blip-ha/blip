{
  "name": "blip-frontend",
  "private": true,
  "version": "0.3.1",
  "description": "Blip sidebar panel for Home Assistant",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite --config vite.preview.config.ts",
    "preview:build": "vite build --config vite.preview.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "catalog": "node scripts/catalog.ts",
    "catalog:check": "node scripts/catalog.ts --check"
  },
  "dependencies": {
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "ajv": "8.20.0",
    "happy-dom": "21.0.4",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
